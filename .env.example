# Banco Neon (Postgres)
DATABASE_URL="postgresql://usuario:senha@ep-seu-projeto.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Segredo para assinatura de sessão JWT httpOnly (mínimo 32 caracteres em produção)
AUTH_SECRET="troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres"

# URL pública da plataforma
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AbacatePay (Pix transparente, subcontas e split)
ABACATEPAY_API_KEY=""
ABACATEPAY_WEBHOOK_SECRET=""
# CPF ou CNPJ da própria plataforma (opcional; bloqueia subconta com o mesmo documento)
PLATFORM_TAX_ID=""

# Uploads (Vercel Blob)
BLOB_READ_WRITE_TOKEN=""

# Admin da plataforma (usado pelo seed)
ADMIN_EMAIL="admin@minhaloja.com.br"
ADMIN_PASSWORD="Admin@1234"

# Opcional em desenvolvimento: gera 400 pedidos demo nos últimos 90 dias (ignorado/proibido em produção)
# SEED_DEMO="true"
